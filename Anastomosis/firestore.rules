rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // User/Student registrations - authenticated users can read/write their own
    match /registrations/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // School registrations - authenticated users can read all, but only write their own
    match /schoolRegistrations/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // User progress tracking - authenticated users can read/write their own progress
    match /userProgress/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Default deny all other documents
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
